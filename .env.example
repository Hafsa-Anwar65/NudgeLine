# Copy this file to .env and fill in your key(s). With several keys, Nudgeline switches
# to the next model by itself when one runs out (see LLM_CHAIN below).

# Option A: Groq (console.groq.com). Key starts with gsk_
GROQ_API_KEY=your_groq_key_here

# Option B: Grok / xAI (console.x.ai). Key starts with xai-
# XAI_API_KEY=your_xai_key_here

# Option C: Claude / Anthropic. Key starts with sk-ant-
# ANTHROPIC_API_KEY=your_claude_key_here

# Optional. Only needed if you set more than one key above: groq, xai or anthropic
# LLM_PROVIDER=groq
# Optional. Exact model name from your provider's console, if the default is rejected.
# LLM_MODEL=llama-3.3-70b-versatile

# --- Several models with automatic fallback (optional) ---
# Order = priority. After a model runs out or fails, the next one takes over without stopping.
# Add @N for an optional daily token budget so the admin dashboard can show what is left.
# LLM_CHAIN=groq:llama-3.3-70b-versatile@500000,groq:openai/gpt-oss-120b,xai:grok-4
# Without LLM_CHAIN it is built from your keys (up to three models per provider).

# --- Admin ---
# Only the admin sees the model dashboard and notifications. Default: the first account created.
# ADMIN_EMAILS=you@example.com
