# Copy this file to .env and fill in ONE of the two keys.

# Option A: Grok (xAI). Key starts with xai-
XAI_API_KEY=your_grok_key_here

# Option B: Claude (Anthropic). Key starts with sk-ant-
# ANTHROPIC_API_KEY=your_claude_key_here

# Optional. By default the provider is picked from whichever key is set.
# LLM_PROVIDER=xai
# Optional. Exact model name from your provider's console, e.g. if the default is "not found".
# LLM_MODEL=grok-4
